# Required. Random string of at least 32 characters. Encrypts the session
# cookie that holds the GitHub access token. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL of this deployment. Used to build the OAuth redirect URI.
APP_URL=http://localhost:3000

# Optional. GitHub OAuth app credentials. Register an OAuth app at
# https://github.com/settings/developers and set the authorization callback
# URL to <APP_URL>/api/auth/github/callback
# Without these the app still works through the access token sign-in form.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Largest accepted size per file, in bytes. Keep this at or below the
# request body limit of your host. Vercel serverless functions cap request
# bodies at 4.5 MB, so the default is 4 MB.
MAX_FILE_BYTES=4194304
